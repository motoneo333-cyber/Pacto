# Local dev. En Vercel la integracion de Supabase ya define NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY (tambien se aceptan).
# Nunca pongas la service role key aqui ni en variables con prefijo VITE_/NEXT_PUBLIC_.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Llave PUBLICA VAPID para notificaciones push (npx web-push generate-vapid-keys). Opcional: sin ella no se ofrece activar notificaciones.
VITE_VAPID_PUBLIC_KEY=
